# Copy this file to .env to give the app keys and connections. Nothing here is needed to try the
# app: with no .env it runs on generated sample data and uses rules only. .env is not committed.
#
#   cp .env.example .env      then edit, then: docker compose up -d --build

# --- Start with no sample data ------------------------------------------------------------------
# true: load the generated demo data and show the demo banner. false: start empty, and the screen
# opens on "Set up a reconciliation" so you can upload your own exports.
RECON_DEMO=true

# --- A language model (optional) ----------------------------------------------------------------
# With a key, the model also proposes column mappings, suggests which invoice an ambiguous payment
# is for, and can write a checked explanation of a case (the buttons appear in the screens).
# Without one, rules do the first two and the third is not offered. Nothing else changes.
# Only masked samples of your columns and, for suggestions and explanations, the memo and the
# amounts, dates and text of the records in question are sent; the README says exactly what.
ANTHROPIC_API_KEY=
# RECON_LLM_MODEL=claude-opus-5-5
# RECON_LLM_EFFORT=low

# --- Files from a bucket (optional) -------------------------------------------------------------
# Used by `docker compose --profile s3 up -d --build`. The defaults point at a local test bucket.
# To read from a real S3 or S3-compatible bucket, set all of these; the key needs read access only.
# RECON_S3_BUCKET=my-finance-exports
# RECON_S3_ENDPOINT_URL=https://s3.eu-west-1.amazonaws.com
# RECON_S3_ACCESS_KEY=
# RECON_S3_SECRET_KEY=
# RECON_S3_PREFIX=incoming/
# RECON_S3_POLL_SECONDS=60

# --- Alerts (optional) --------------------------------------------------------------------------
# Slack and Teams webhooks are added on the Alerts page. Email needs a mail server:
# RECON_SMTP_HOST=smtp.example.com
# RECON_SMTP_PORT=587
# RECON_SMTP_USER=
# RECON_SMTP_PASSWORD=
# RECON_SMTP_FROM=reconciliation@example.com
# The address put in the links of a message:
# RECON_PUBLIC_URL=http://127.0.0.1:8000
